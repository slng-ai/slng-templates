# Your SLNG API key. For speech_router.py and speech_router_byok.py, create it in a
# project on the Execution Layer: Improve my agent > Pipecat, then Project Vault >
# SLNG API key. speech.py works with any SLNG key.
SLNG_API_KEY=

# The region you picked when you created the project, as a gateway code. The key
# only works in that region. See https://docs.slng.ai/guides/regions/regions-map
SLNG_REGION=eu-north

# One stable ID per agent. Change it when you change the prompt in a meaningful way.
SLNG_AGENT_ID=wayne-concierge-v1

# speech.py and speech_router_byok.py: your own OpenAI key and model.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna

# speech_router.py: slng/auto answers with the model chosen in your project's
# Think section. Or name one model of that configuration to pin it.
SLNG_ROUTER_MODEL=slng/auto

